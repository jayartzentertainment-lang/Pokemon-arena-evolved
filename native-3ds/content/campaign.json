  "events": [
    {
      "map": 0,
      "name": "Mom",
      "npc": "mom",
      "text": "A new day in Twinleaf! Barry is waiting outside. Your clothes are ready; this is your own journey.",
      "kind": "talk",
      "trainer": "",
      "level": 0,
      "badge": -1,
      "doubles": false
    },
    {
      "map": 0,
      "name": "Barry",
      "npc": "barry",
      "text": "There you are! Let us find Professor Rowan on Route 201. No running into the tall grass without a Pokemon!",
      "kind": "talk",
      "trainer": "",
      "level": 0,
      "badge": -1,
      "doubles": false
    },
    {
      "map": 1,
      "name": "Professor Rowan",
      "npc": "prof_rowan",
      "text": "You both want Pokemon? A partner is a responsibility. Choose Turtwig, Chimchar, or Piplup.",
      "kind": "starter",
      "trainer": "",
      "level": 0,
      "badge": -1,
      "doubles": false
    },
    {
      "map": 1,
      "name": "Barry",
      "npc": "barry",
      "text": "I picked my partner too! Let us see how our Pokemon move in a real battle!",
      "kind": "rival",
      "trainer": "",
      "level": 5,
      "badge": -1,
      "doubles": false
    },
    {
      "map": 0,
      "name": "Mom",
      "npc": "mom",
      "text": "Your very first battle! I have healed your partner. Go to Lake Verity with Barry, then visit Rowan in Sandgem.",
      "kind": "talk",
      "trainer": "",
      "level": 0,
      "badge": -1,
      "doubles": false
    },
    {
      "map": 2,
      "name": "Cyrus",
      "npc": "cyrus",
      "text": "This lake holds a legend. Emotion creates conflict... One day the world will change.",
      "kind": "talk",
      "trainer": "",
      "level": 0,
      "badge": -1,
      "doubles": false
    },
    {
      "map": 3,
      "name": "Professor Rowan",
      "npc": "prof_rowan",
      "text": "You and your partner share a bond already. Take this Pokedex and record Sinnoh Pokemon. Meet my assistant on Route 202.",
      "kind": "talk",
      "trainer": "",
      "level": 0,
      "badge": -1,
      "doubles": false
    },
    {
      "map": 4,
      "name": "Dawn",
      "npc": "dawn",
